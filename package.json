{
  "name": "angle-lenticular-cards",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive three-photo lenticular card prototype with iridescent surface reflections and crop editing",
  "scripts": {
    "start": "node prototype/transition-server.cjs",
    "start:baseline": "node prototype/final-server.cjs",
    "build": "node prototype/build-final.cjs && node prototype/build-transition-study.cjs",
    "build:pages": "npm run build && node prototype/build-pages.cjs",
    "build:offline": "npm run build && node prototype/build-offline.cjs",
    "check:transitions": "node prototype/check-transition-modes.cjs"
  },
  "engines": { "node": ">=18" }
}
